# Backend Configuration
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Local single-user mode: skips OAuth login and API rate limiting
# LOCAL_AUTH_BYPASS=true

# Database
DATABASE_URL=postgresql://postgres:password@postgres:5432/daily_dashboard
# Local mode: start a bundled PostgreSQL automatically (data in backend/.pgdata);
# use with e.g. DATABASE_URL=postgresql://postgres:password@localhost:5433/daily_dashboard
# EMBEDDED_POSTGRES=true

# Session
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# OAuth - Google (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth - GitHub (Optional)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# LLM Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=gemini
ONBOARDING_LLM_PROVIDER=gemini

# Alternative Providers (Groq / Ollama / HuggingFace)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_URL=http://ollama:11434
# Must match a model shown by `ollama list` (e.g. llama3.2:3b)
LLM_MODEL=llama3
ENABLE_FALLBACK=true

